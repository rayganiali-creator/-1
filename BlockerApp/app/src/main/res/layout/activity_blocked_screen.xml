<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/blocker_blocked_bg"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgBear"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/bear_agent"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtSessionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="این محتوا مسدود شده است"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بازگشت به صفحه اصلی"
        android:backgroundTint="@color/blocker_mint"
        android:textColor="@color/blocker_ink" />

</LinearLayout>
