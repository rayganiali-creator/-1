<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/blocker_blocked_bg"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgShield"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/shield_outline_mint"
        android:layout_marginBottom="24dp" />

    <ImageView
        android:id="@+id/imgBear"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/bear_agent_full"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="این محتوا مسدود است"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="سد از تو محافظت می‌کند"
        android:textColor="@color/blocker_on_surface_variant"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="بازگشت"
        android:background="@drawable/btn_mint_pill"
        android:textColor="@color/blocker_ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnWrongBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="این بلاک اشتباه بود؟"
        android:textColor="@color/blocker_on_surface_variant"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
