<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="برای فعال شدن بلاک، ابتدا سرویس Accessibility را روشن کنید."
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEnableService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فعال‌سازی سرویس بلاکر (Accessibility)"
            android:backgroundTint="@color/primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- بخش برنامه‌ها -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="برنامه‌های مسدود شده"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnManageApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="انتخاب برنامه‌ها برای مسدودسازی" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- بخش سایت‌ها -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سایت‌های مسدود شده"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مثال: instagram.com یا youtube.com"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWebsite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="example.com"
                android:inputType="textUri"
                android:autofillHints="" />

            <Button
                android:id="@+id/btnAddWebsite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="افزودن" />
        </LinearLayout>

        <ListView
            android:id="@+id/listWebsites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- بخش کلمات کلیدی -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="کلمات کلیدی مسدود شده"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="هر صفحه‌ای که این کلمه را نمایش دهد بسته می‌شود"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etKeyword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="کلمه یا عبارت"
                android:inputType="text"
                android:autofillHints="" />

            <Button
                android:id="@+id/btnAddKeyword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="افزودن" />
        </LinearLayout>

        <ListView
            android:id="@+id/listKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
